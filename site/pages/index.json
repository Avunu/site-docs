{
  "$schema": "../document.schema.json",
  "$layout": "./layouts/base.json",
  "$description": "The landing page of the site: the name and tagline of the whole documentation, and one card per project that has documentation here, grouped by platform. The projects come from the catalog that the build writes from projects.json; every card links to the project's own landing page.",
  "title": "${state.config.data.name}",
  "state": {
    "projectGroups": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "const esc = (t) => String(t).replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('${', '&#36;{');\nconst labels = { frappe: 'Frappe & ERPNext', odoo: 'Odoo', wordpress: 'WordPress', nixos: 'NixOS', general: 'General' };\nconst order = ['frappe', 'odoo', 'wordpress', 'nixos', 'general'];\nconst projects = ((state.catalog.data && state.catalog.data.projects) || []).filter((p) => p && typeof p.docs === 'string' && p.docs.indexOf('https://') === 0 && typeof p.platform === 'string');\nconst by = Object.create(null);\nprojects.forEach((p) => { (by[p.platform] = by[p.platform] || []).push(p); });\nconst keys = order.filter((k) => by[k]).concat(Object.keys(by).filter((k) => order.indexOf(k) === -1).sort());\nconst pathOf = (u) => { try { return new URL(u).pathname; } catch (e) { return u; } };\nreturn keys.map((k) => ({\n  tagName: 'section',\n  attributes: { class: 'start', 'aria-labelledby': 'group-' + k },\n  children: [\n    { tagName: 'h2', attributes: { id: 'group-' + k }, innerHTML: esc(labels[k] || k) },\n    { tagName: 'ul', attributes: { class: 'cards' }, children: by[k].slice().sort((a, b) => String(a.title).localeCompare(String(b.title), 'en', { sensitivity: 'base' })).map((p) => ({\n      tagName: 'li',\n      children: [{ tagName: 'a', attributes: { class: 'card', href: pathOf(p.docs) }, children: [\n        { tagName: 'span', attributes: { class: 'k' }, innerHTML: esc(p.license || 'Open source') },\n        { tagName: 'span', attributes: { class: 't' }, innerHTML: esc(p.title) },\n        { tagName: 'span', attributes: { class: 'd' }, innerHTML: esc(p.summary || '') }\n      ] }]\n    })) }\n  ]\n}));"
    },
    "hasProjects": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "return state.projectGroups.length > 0;"
    }
  },
  "children": [
    {
      "tagName": "main",
      "attributes": {
        "id": "main",
        "tabindex": "-1"
      },
      "style": {
        "flex": "1 0 auto",
        "width": "100%",
        "& .hero": {
          "maxWidth": "var(--container)",
          "margin": "0 auto",
          "padding": "clamp(48px, 9vw, 112px) var(--gutter) clamp(40px, 6vw, 72px)",
          "display": "flex",
          "flexDirection": "column",
          "alignItems": "flex-start",
          "gap": "0"
        },
        "& .eyebrow": {
          "display": "inline-flex",
          "alignItems": "center",
          "gap": "8px",
          "margin": "0 0 24px",
          "padding": "6px 14px",
          "backgroundColor": "var(--color-surface)",
          "border": "1px solid var(--color-surface-border)",
          "borderRadius": "var(--radius-pill)",
          "fontSize": "13px",
          "color": "var(--color-text-muted)"
        },
        "& .eyebrow::before": {
          "content": "''",
          "width": "8px",
          "height": "8px",
          "borderRadius": "50%",
          "backgroundColor": "var(--color-signal)"
        },
        "& h1": {
          "fontSize": "var(--text-display)",
          "letterSpacing": "var(--tracking-tight)",
          "lineHeight": "1.02",
          "overflowWrap": "anywhere",
          "maxWidth": "16em"
        },
        "& .lede": {
          "margin": "24px 0 0",
          "maxWidth": "36em",
          "fontSize": "clamp(18px, 2vw, 22px)",
          "lineHeight": "1.5",
          "color": "var(--color-text-muted)"
        },
        "& .actions": {
          "display": "flex",
          "flexWrap": "wrap",
          "gap": "12px",
          "margin": "36px 0 0"
        },
        "& .btn": {
          "display": "inline-flex",
          "alignItems": "center",
          "justifyContent": "center",
          "gap": "8px",
          "minHeight": "var(--hit)",
          "padding": "0 22px",
          "borderRadius": "var(--radius-pill)",
          "fontSize": "16px",
          "fontWeight": "500",
          "textDecoration": "none",
          "border": "1px solid transparent"
        },
        "& .btn.primary": {
          "backgroundColor": "var(--color-action)",
          "color": "var(--color-on-action)"
        },
        "& .btn.primary:hover": {
          "backgroundColor": "var(--color-action-hover)",
          "color": "var(--color-on-action)"
        },
        "& .btn.secondary": {
          "backgroundColor": "var(--color-action-soft)",
          "color": "var(--color-on-action-soft)"
        },
        "& .btn.secondary:hover": {
          "borderColor": "var(--color-on-action-soft)"
        },
        "& .facts": {
          "display": "flex",
          "flexWrap": "wrap",
          "gap": "8px 24px",
          "margin": "28px 0 0",
          "padding": "0",
          "listStyle": "none",
          "fontSize": "14px",
          "color": "var(--color-text-muted)"
        },
        "& .facts b": {
          "color": "var(--color-text)",
          "fontWeight": "600"
        },
        "& .start": {
          "maxWidth": "var(--container)",
          "margin": "0 auto",
          "padding": "0 var(--gutter) clamp(48px, 8vw, 96px)"
        },
        "& .start h2": {
          "fontSize": "var(--text-h3)",
          "marginBottom": "20px"
        },
        "& .cards": {
          "display": "grid",
          "gridTemplateColumns": "repeat(auto-fill, minmax(280px, 1fr))",
          "gap": "16px",
          "listStyle": "none",
          "margin": "0",
          "padding": "0"
        },
        "& .card": {
          "display": "flex",
          "flexDirection": "column",
          "gap": "8px",
          "height": "100%",
          "padding": "20px",
          "backgroundColor": "var(--color-surface)",
          "border": "1px solid var(--color-surface-border)",
          "borderRadius": "var(--radius-lg)",
          "color": "var(--color-text)",
          "textDecoration": "none",
          "transition": "border-color 0.15s"
        },
        "& .card:hover": {
          "borderColor": "var(--color-action)"
        },
        "& .card .k": {
          "fontSize": "12px",
          "fontWeight": "600",
          "color": "var(--color-text-caption)"
        },
        "& .card .t": {
          "fontSize": "var(--text-title)",
          "fontWeight": "500",
          "letterSpacing": "var(--tracking-soft)"
        },
        "& .card .d": {
          "fontSize": "15px",
          "lineHeight": "1.5",
          "color": "var(--color-text-muted)"
        },
        "& .band": {
          "backgroundColor": "var(--color-bg-lavender)"
        },
        "& .band .inner": {
          "maxWidth": "var(--container)",
          "margin": "0 auto",
          "padding": "32px var(--gutter)",
          "display": "flex",
          "flexWrap": "wrap",
          "alignItems": "center",
          "justifyContent": "space-between",
          "gap": "16px 32px"
        },
        "& .band p": {
          "margin": "0",
          "maxWidth": "40em",
          "fontSize": "17px",
          "lineHeight": "1.5"
        }
      },
      "children": [
        {
          "tagName": "section",
          "attributes": {
            "class": "hero",
            "aria-labelledby": "home-title"
          },
          "children": [
            {
              "tagName": "p",
              "attributes": {
                "class": "eyebrow"
              },
              "textContent": "Open source"
            },
            {
              "tagName": "h1",
              "attributes": {
                "id": "home-title"
              },
              "textContent": "${state.config.data.name}"
            },
            {
              "tagName": "p",
              "attributes": {
                "class": "lede"
              },
              "textContent": "${state.config.data.tagline}"
            },
            {
              "tagName": "div",
              "attributes": {
                "class": "actions"
              },
              "children": [
                {
                  "tagName": "a",
                  "attributes": {
                    "class": "btn primary",
                    "href": "https://avunu.net/open-source/"
                  },
                  "children": [
                    "All projects",
                    {
                      "tagName": "docs-icon",
                      "$props": {
                        "name": "arrow-right",
                        "size": "18"
                      }
                    }
                  ]
                },
                {
                  "tagName": "a",
                  "attributes": {
                    "class": "btn secondary",
                    "href": "${state.config.data.repo}"
                  },
                  "children": [
                    {
                      "tagName": "docs-icon",
                      "$props": {
                        "name": "github",
                        "size": "18"
                      }
                    },
                    "Avunu on GitHub"
                  ]
                }
              ]
            }
          ]
        },
        {
          "tagName": "div",
          "children": "${state.projectGroups}"
        }
      ]
    }
  ]
}
