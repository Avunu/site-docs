{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "ignorePatterns": [
    "build",
    "dist",
    "node_modules",
    "projects/**",
    "site/**",
    "verify/**",
    ".site-docs",
    "test/fixtures",
    "test/**/fixtures"
  ],
  "plugins": ["typescript", "oxc", "import"],
  "overrides": [
    {
      "files": ["test/**"],
      "rules": {
        "no-await-in-loop": "off"
      }
    }
  ]
}
